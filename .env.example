# Copy to .env and fill in.
SITE_ADDRESS=kreuzfahrt.example.de
CRUISE_LANGUAGE=de

# Sign-in (login page of the app). Create the three values on your own computer with
#   pnpm --filter @cruise/api auth:setup --user dusan --totp
# which prints the lines below (and a random password, and the key for the authenticator app). Without --totp the
# password alone signs in; with AUTH_TOTP_SECRET the page also asks for the 6-digit code.
AUTH_USER=dusan
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_TOTP_SECRET=
# 1 = session cookie only over HTTPS (default). 0 only for http://localhost tests.
AUTH_COOKIE_SECURE=1

# Private access only (VPN): the VPN address of the server, e.g. its Tailscale IP. Empty = reachable from the internet.
# With a VPN also set SITE_ADDRESS=:80 and AUTH_COOKIE_SECURE=0 (the VPN already encrypts the traffic).
BIND_IP=
