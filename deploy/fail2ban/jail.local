# SSH brute-force protection for the Strato VPS (docs/deployment-strato.md, step 9).
# Install: apt install -y fail2ban; then copy this file to /etc/fail2ban/jail.local and `systemctl restart fail2ban`.
# Check: fail2ban-client status sshd

[sshd]
enabled = true
port = ssh
backend = systemd
maxretry = 4
findtime = 10m
bantime = 1h
# Repeated bans from the same address escalate instead of just repeating the same hour-long ban.
bantime.increment = true
bantime.factor = 4
bantime.maxtime = 1w
